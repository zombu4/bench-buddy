#!/bin/sh
# Pre-removal for bench-buddy.
#
# Removes the /usr/bin symlink that postinst created.  dpkg does not know
# about it, so nothing else would.
set -e

LINK=/usr/bin/bench-buddy

case "$1" in
    remove|upgrade|deconfigure)
        if [ -L "$LINK" ]; then
            rm -f "$LINK"
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
